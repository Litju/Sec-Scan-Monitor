{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secscanmonitor.local/contracts/schemas/DeltaOutputContract.schema.json",
  "title": "DeltaOutputContract",
  "description": "Delta explanation output.",
  "type": "object",
  "additionalProperties": false,
  "x-producer": "delta-runtime-advisory-agent",
  "x-persisted": false,
  "properties": {
    "contract_version": {
      "type": "string",
      "description": "Contract version identifier for the DeltaOutputContract schema instance.",
      "x-trust-level": "advisory-transient"
    },
    "delta_summary": {
      "type": "string",
      "description": "Summary of significant change patterns.",
      "x-trust-level": "advisory-transient"
    },
    "key_changes": {
      "type": "array",
      "description": "Important changes highlighted by Delta.",
      "items": {
        "type": "string",
        "description": "Key change note.",
        "x-trust-level": "advisory-transient"
      },
      "x-trust-level": "advisory-transient"
    },
    "confidence": {
      "type": "number",
      "description": "Advisory confidence value for Delta output.",
      "x-trust-level": "advisory-transient"
    }
  },
  "required": [
    "contract_version",
    "delta_summary",
    "key_changes",
    "confidence"
  ]
}

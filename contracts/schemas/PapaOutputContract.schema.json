{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secscanmonitor.local/contracts/schemas/PapaOutputContract.schema.json",
  "title": "PapaOutputContract",
  "description": "Workflow planning output.",
  "type": "object",
  "additionalProperties": false,
  "x-producer": "papa-runtime-advisory-agent",
  "x-persisted": false,
  "properties": {
    "contract_version": {
      "type": "string",
      "description": "Contract version identifier for the PapaOutputContract schema instance.",
      "x-trust-level": "advisory-transient"
    },
    "recommended_actions": {
      "type": "array",
      "description": "Recommended actions generated by Papa.",
      "items": {
        "$ref": "./RecommendedAction.schema.json"
      },
      "x-trust-level": "advisory-transient"
    },
    "blocked_actions": {
      "type": "array",
      "description": "Descriptions of blocked actions that must not proceed.",
      "items": {
        "type": "string",
        "description": "Blocked action description.",
        "x-trust-level": "advisory-transient"
      },
      "x-trust-level": "advisory-transient"
    },
    "confidence": {
      "type": "number",
      "description": "Advisory confidence value for Papa output.",
      "x-trust-level": "advisory-transient"
    }
  },
  "required": [
    "contract_version",
    "recommended_actions",
    "blocked_actions",
    "confidence"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secscanmonitor.local/contracts/schemas/AlphaOutputContract.schema.json",
  "title": "AlphaOutputContract",
  "description": "Advisory orchestration and scope-gating output.",
  "type": "object",
  "additionalProperties": false,
  "x-producer": "alpha-runtime-advisory-agent",
  "x-persisted": false,
  "properties": {
    "contract_version": {
      "type": "string",
      "description": "Contract version identifier for the AlphaOutputContract schema instance.",
      "x-trust-level": "advisory-transient"
    },
    "routed_agents": {
      "type": "array",
      "description": "Runtime agent names routed by Alpha.",
      "items": {
        "type": "string",
        "description": "Runtime advisory agent name.",
        "x-trust-level": "advisory-transient"
      },
      "x-trust-level": "advisory-transient"
    },
    "scope_ok": {
      "type": "boolean",
      "description": "Whether the advisory request remained within approved scope.",
      "x-trust-level": "advisory-transient"
    },
    "rejected_reasons": {
      "type": "array",
      "description": "Reasons Alpha rejected out-of-scope routing or output.",
      "items": {
        "type": "string",
        "description": "Rejection reason.",
        "x-trust-level": "advisory-transient"
      },
      "x-trust-level": "advisory-transient"
    },
    "confidence": {
      "type": "number",
      "description": "Advisory confidence value for Alpha output.",
      "x-trust-level": "advisory-transient"
    }
  },
  "required": [
    "contract_version",
    "routed_agents",
    "scope_ok",
    "rejected_reasons",
    "confidence"
  ]
}
